#!/bin/sh
# Allowlist for own-your-glass's DNS blocking: domains in ALLOW (one per line) are
# taken out of its hosts file. The DNS sink suffix-matches, so allowing "lgappstv.com"
# unblocks the store while a separate "ad.lgappstv.com" rule stays in force.
# own-your-glass regenerates the file at boot and on every Apply, so re-check every minute.
# Installed to /var/lib/webosbrew/init.d/. Undo: rm this script and the allow file, reboot.

ALLOW=/var/lib/lgtv-tweaks/dns-allow.txt
HOSTS=/var/lib/own-your-glass/hosts
PIDFILE=/tmp/oyg-allow.pid

[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && exit 0

prune() {
    [ -f "$HOSTS" ] && [ -f "$ALLOW" ] || return 0
    pat=$(grep -v '^[[:space:]]*\(#\|$\)' "$ALLOW" | sed 's/[[:space:]].*//; s/\./\\./g' | tr '\n' '|' | sed 's/|$//')
    [ -n "$pat" ] || return 0
    re="^[^#[:space:]]+[[:space:]]+($pat)[[:space:]]*\$"
    grep -qE "$re" "$HOSTS" || return 0
    # Rewrite in place: /etc/hosts is a bind mount of this inode.
    grep -vE "$re" "$HOSTS" > /tmp/oyg-allow.hosts && cat /tmp/oyg-allow.hosts > "$HOSTS"
    rm -f /tmp/oyg-allow.hosts
}

(
    while :; do
        prune
        sleep 60
    done
) </dev/null >/dev/null 2>&1 &
echo $! > "$PIDFILE"
